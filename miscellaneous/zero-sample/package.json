{
  "private": true,
  "type": "module",
  "sideEffects": false,
  "name": "zero-sample",
  "packageManager": "yarn@4.1.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "worker": "tsx scripts/worker.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "start:zero": "ZERO_PORT=4848 zero-cache",
    "start:app": "PORT=3001 NITRO_PORT=3001 node .output/server/index.mjs",
    "start:proxy": "CADDY_PORT=3000 caddy run --config /etc/caddy/Caddyfile",
    "start:container": "concurrently --names app,zero,worker,proxy --kill-others \"npm run start:app\" \"npm run start:zero\" \"npm run worker\" \"npm run start:proxy\""
  },
  "dependencies": {
    "@noble/ciphers": "2.1.1",
    "@rocicorp/zero": "0.25.2",
    "@tanstack/react-form": "1.28.3",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-query-devtools": "5.91.3",
    "@tanstack/react-router": "1.160.2",
    "@tanstack/react-router-devtools": "1.160.2",
    "@tanstack/react-start": "1.160.2",
    "better-auth": "1.4.18",
    "bullmq": "5.69.3",
    "concurrently": "9.2.1",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.1",
    "nanoid": "5.1.6",
    "postgres": "3.4.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "reshaped": "3.9.0",
    "zero-cache": "1.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "22.19.11",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.4",
    "drizzle-kit": "0.31.9",
    "nitro": "3.0.1-alpha.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "6.1.1"
  }
}
