{
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "name": "electric-sql-tutorial",
  "scripts": {
    "dev": "npm-run-all --parallel dev:docker dev:api dev:app",
    "dev:app": "vite dev --host 127.0.0.1 --port 3001",
    "dev:api": "tsx watch server/index.ts",
    "dev:docker": "docker-compose up -d",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:reset": "docker-compose down -v && docker-compose up -d"
  },
  "dependencies": {
    "@electric-sql/client": "^0.6.0",
    "@hono/node-server": "^1.13.7",
    "@mantine/hooks": "^8.3.14",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.159.10",
    "@tanstack/react-start": "1.159.13",
    "@tanstack/router-plugin": "1.159.12",
    "bcryptjs": "^3.0.3",
    "cookie": "1.1.1",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.36.4",
    "hono": "^4.6.14",
    "jsonwebtoken": "^9.0.2",
    "nitro": "npm:nitro-nightly@latest",
    "nuqs": "^2.8.8",
    "postgres": "^3.4.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^5.1.2",
    "drizzle-kit": "^0.28.1",
    "npm-run-all2": "^8.0.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "6.0.3"
  }
}
